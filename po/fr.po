msgid "Open the destination folder"
msgstr "Ouvrir le dossier de destination"

#: nautilus-extension/convert-images-gui:316
msgid "Quit"
msgstr "Quitter"

#: nautilus-extension/convert-images-gui:340
msgid "No recognized image file in the selection."
msgstr "Aucun fichier image reconnu dans la sélection."

#: nautilus-extension/convert-images-gui:348
#, python-brace-format
msgid "{n} file detected: {details}"
msgid_plural "{n} files detected: {details}"
msgstr[0] "{n} fichier détecté : {details}"
msgstr[1] "{n} fichiers détectés : {details}"

#: nautilus-extension/convert-images-gui:371
msgid "Choose the destination folder"
msgstr "Choisir le dossier de destination"

#: nautilus-extension/convert-images-gui:427
#, python-brace-format
msgid "Converting to {format} → {folder}\n"
msgstr "Conversion vers {format} → {folder}\n"

#: nautilus-extension/convert-images-gui:444
#, python-brace-format
msgid "[OK] {input} → {output}\n"
msgstr "[OK] {input} → {output}\n"

#: nautilus-extension/convert-images-gui:450
#, python-brace-format
msgid "[ERROR] {input}: {message}\n"
msgstr "[ERREUR] {input} : {message}\n"

#: nautilus-extension/convert-images-gui:459
#, python-brace-format
msgid ""
"\n"
"Finished — succeeded: {ok}, errors: {errors}.\n"
msgstr ""
"\n"
"Terminé — réussites : {ok}, erreurs : {errors}.\n"

#: nautilus-extension/convert-images-gui:462
#, python-brace-format
msgid "Conversion finished — succeeded: {ok}, errors: {errors}."
msgstr "Conversion terminée — réussites : {ok}, erreurs : {errors}."

#: nautilus-extension/convert-images-gui:468
#, python-brace-format
msgid "[FATAL ERROR] {message}\n"
msgstr "[ERREUR FATALE] {message}\n"

#: nautilus-extension/convert-images-gui:482
msgid ""
"\n"
"Conversion cancelled by the user.\n"
msgstr ""
"\n"
"Conversion annulée par l'utilisateur.\n"

#: nautilus-extension/convert-images-gui:511
msgid "Conversion in progress"
msgstr "Conversion en cours"

#: nautilus-extension/convert-images-gui:514
msgid ""
"Quitting now will interrupt the conversion in progress. Files already "
"converted stay on disk; the remaining ones will not be processed."
msgstr ""
"Quitter maintenant interrompra la conversion en cours. Les fichiers déjà "
"convertis restent sur le disque ; les suivants ne seront pas traités."

#: nautilus-extension/convert-images-gui:519
msgid "Quit anyway"
msgstr "Quitter quand même"

#: nautilus-extension/convert-images-gui:550
#, python-brace-format
msgid "[ERROR] could not start the engine: {error}\n"
msgstr "[ERREUR] impossible de lancer le moteur : {error}\n"

#: nautilus-extension/convert-images-gui:599
msgid "nautilus-convert-images graphical interface"
msgstr "Interface graphique de nautilus-convert-images"

#: nautilus-extension/convert-images-gui:600
msgid "File containing one path per line"
msgstr "Fichier contenant un chemin par ligne"

#: nautilus-extension/convert-images-gui:601
msgid "Files or folders to process"
msgstr "Fichiers ou dossiers à traiter"

#: nautilus-extension/convert-images-gui:609
msgid "No file or folder provided."
msgstr "Aucun fichier ou dossier fourni."

#: nautilus-extension/convert_images_nautilus.py:87
msgid "Convert images…"
msgstr "Convertir les images…"

#: nautilus-extension/convert_images_nautilus.py:88
