#: nautilus-extension/convert-images-gui:51
msgid "JPEG (lossy, adjustable quality)"
msgstr "JPEG (avec perte, qualité réglable)"

#: nautilus-extension/convert-images-gui:52
msgid "PNG (lossless)"
msgstr "PNG (sans perte)"

#: nautilus-extension/convert-images-gui:53
msgid "Uncompressed TIFF (lossless)"
msgstr "TIFF non compressé (sans perte)"

#: nautilus-extension/convert-images-gui:54
msgid "BMP (lossless)"
msgstr "BMP (sans perte)"

#: nautilus-extension/convert-images-gui:55
msgid "Lossless WebP"
msgstr "WebP sans perte"

#: nautilus-extension/convert-images-gui:59
msgid "Rename the new file"
msgstr "Renommer le nouveau fichier"

#: nautilus-extension/convert-images-gui:60
msgid "Skip the file"
msgstr "Ignorer le fichier"

#: nautilus-extension/convert-images-gui:61
msgid "Replace the existing file"
msgstr "Remplacer le fichier existant"

#: nautilus-extension/convert-images-gui:66
msgid "Unknown"
msgstr "Inconnu"

#: nautilus-extension/convert-images-gui:67
msgid "Generic RAW"
msgstr "RAW générique"

#. TRANSLATORS: {primary} is the error of the main RAW decoder and {fallback}
#. the error of LibRaw, the backup decoder tried afterwards.
#: nautilus-extension/convert-images-gui:78
#, python-brace-format
msgid "{primary} ; LibRaw fallback: {fallback}"
msgstr "{primary} ; repli LibRaw : {fallback}"

#: nautilus-extension/convert-images-gui:79
#, python-brace-format
msgid "cannot open RAW file: {detail}"
msgstr "ouverture du fichier RAW impossible : {detail}"

#: nautilus-extension/convert-images-gui:80
#, python-brace-format
msgid "RAW decoding failed: {detail}"
msgstr "échec du décodage RAW : {detail}"

#: nautilus-extension/convert-images-gui:81
#, python-brace-format
msgid "decoding failed: {detail}"
msgstr "échec du décodage : {detail}"

#: nautilus-extension/convert-images-gui:82
#, python-brace-format
msgid "could not create the output file: {detail}"
msgstr "impossible de créer le fichier de sortie : {detail}"

#: nautilus-extension/convert-images-gui:83
#, python-brace-format
msgid "could not create the output folder: {detail}"
msgstr "impossible de créer le dossier de destination : {detail}"

#. TRANSLATORS: {format} is the target format name (JPEG, PNG, TIFF, BMP, WebP).
#: nautilus-extension/convert-images-gui:85
#, python-brace-format
msgid "{format} encoding failed: {detail}"
msgstr "échec de l'encodage {format} : {detail}"

#: nautilus-extension/convert-images-gui:86
#, python-brace-format
msgid "{name}: internal decoder error (corrupted file?)"
msgstr "{name} : erreur interne du décodeur (fichier corrompu ?)"

#: nautilus-extension/convert-images-gui:87
msgid "skipped (the destination file already exists)"
msgstr "ignoré (le fichier de destination existe déjà)"

#: nautilus-extension/convert-images-gui:88
msgid "LibRaw: initialization failed"
msgstr "LibRaw : échec de l'initialisation"

#: nautilus-extension/convert-images-gui:89
msgid "invalid path (null byte)"
msgstr "chemin invalide (octet nul)"

#: nautilus-extension/convert-images-gui:90
#, python-brace-format
msgid "inconsistent {bits}-bit RAW buffer size"
msgstr "taille de tampon RAW {bits} bits incohérente"

#: nautilus-extension/convert-images-gui:91
#, python-brace-format
msgid ""
"LibRaw: unexpected developed image (type {kind}, {colors} channels, {depth} "
"bits)"
msgstr ""
"LibRaw : image développée inattendue (type {kind}, {colors} canaux, {depth} "
"bits)"

#: nautilus-extension/convert-images-gui:92
#, python-brace-format
msgid "LibRaw: inconsistent image size ({size} bytes, {expected} expected)"
msgstr ""
"LibRaw : taille d'image incohérente ({size} octets, {expected} attendus)"

#: nautilus-extension/convert-images-gui:155
msgid "New folder"
msgstr "Nouveau dossier"

#: nautilus-extension/convert-images-gui:167
#, python-brace-format
msgid "Create in: {folder}"
msgstr "Créer dans : {folder}"

#: nautilus-extension/convert-images-gui:170
msgid "Folder name"
msgstr "Nom du dossier"

#. TRANSLATORS: default name proposed for the new destination folder
#. (a single lowercase word, e.g. "converted").
#: nautilus-extension/convert-images-gui:173
msgid "converted"
msgstr "converti"

#: nautilus-extension/convert-images-gui:182
#: nautilus-extension/convert-images-gui:519
msgid "Cancel"
msgstr "Annuler"

#: nautilus-extension/convert-images-gui:184
msgid "Create"
msgstr "Créer"

#: nautilus-extension/convert-images-gui:196
msgid "The name cannot be empty."
msgstr "Le nom ne peut pas être vide."

#: nautilus-extension/convert-images-gui:202
#, python-brace-format
msgid "Could not create the folder: {error}"
msgstr "Impossible de créer le dossier : {error}"

#: nautilus-extension/convert-images-gui:210
msgid "Convert images"
msgstr "Convertir les images"

