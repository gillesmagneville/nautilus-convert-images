msgid "JPEG quality:"
msgstr "Qualité JPEG :"

#: nautilus-extension/convert-images-gui:258
msgid "If the file already exists:"
msgstr "En cas de fichier existant :"

#: nautilus-extension/convert-images-gui:265
msgid "Destination folder:"
msgstr "Dossier de destination :"

#: nautilus-extension/convert-images-gui:271
msgid "Browse…"
msgstr "Parcourir…"

#: nautilus-extension/convert-images-gui:274
msgid "New folder…"
msgstr "Nouveau dossier…"

#: nautilus-extension/convert-images-gui:285
msgid "Cancel conversion"
msgstr "Annuler la conversion"

#: nautilus-extension/convert-images-gui:289
msgid "Convert"
msgstr "Convertir"

