#!/usr/bin/env python3
"""
convert-images-gui — interface graphique GTK4 autonome pour nautilus-convert-images.

Lancée par l'extension Nautilus (ou manuellement) avec une liste de
fichiers/dossiers sélectionnés, cette application :
  1. détecte le format de toutes les images trouvées (récursivement dans
     les dossiers sélectionnés), en déléguant au moteur `convert-images-engine` ;
  2. propose un format de destination, une qualité (JPEG), un dossier de
     sortie (avec création de nouveau dossier) et une politique en cas de
     collision de noms ;
  3. lance la conversion via `convert-images-engine` et affiche la progression
     en temps réel, sans jamais recadrer ni redimensionner les images.
"""

import argparse
import gettext
import json
import os
import re
import subprocess
import sys

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gio, GLib, Gtk  # noqa: E402

# CONVERT_IMAGES_ENGINE et CONVERT_IMAGES_LOCALEDIR ne servent qu'au
# développement et aux tests (moteur ou catalogues non installés).
ENGINE_BINARY = os.environ.get("CONVERT_IMAGES_ENGINE", "/usr/bin/convert-images-engine")

# --- Internationalisation (gettext) ------------------------------------
# Textes sources en anglais ; la langue est choisie d'après l'environnement
# (LANGUAGE, LC_ALL, LC_MESSAGES, LANG). Sans traduction disponible pour la
# langue de l'utilisateur, l'anglais s'affiche.
I18N_DOMAIN = "nautilus-convert-images"
LOCALE_DIR = os.environ.get("CONVERT_IMAGES_LOCALEDIR", "/usr/share/locale")
_translation = gettext.translation(I18N_DOMAIN, localedir=LOCALE_DIR, fallback=True)
_ = _translation.gettext
ngettext = _translation.ngettext


def N_(msgid):
    """Marque une chaîne pour l'extraction (xgettext) sans la traduire tout
    de suite : la traduction se fait à l'affichage."""
    return msgid


FORMAT_CHOICES = [
    ("jpeg", N_("JPEG (lossy, adjustable quality)")),
    ("png", N_("PNG (lossless)")),
    ("tiff", N_("Uncompressed TIFF (lossless)")),
    ("bmp", N_("BMP (lossless)")),
    ("webp", N_("Lossless WebP")),
]

COLLISION_CHOICES = [
    ("rename", N_("Rename the new file")),
    ("skip", N_("Skip the file")),
    ("overwrite", N_("Replace the existing file")),
]

# Libellés de format émis par le moteur qui ne sont pas des noms propres.
FORMAT_LABELS = {
    "Unknown": N_("Unknown"),
    "Generic RAW": N_("Generic RAW"),
}

# Messages d'erreur du moteur. Contrat : le moteur les émet en anglais (voir
# ARCHITECTURE.md) ; l'IHM les traduit. Chaque modèle sert à la fois de
# motif de reconnaissance et de msgid : un message inconnu s'affiche tel
# quel. Garder ces modèles synchronisés avec src/*.rs (tests/test_i18n.py
# le vérifie).
ENGINE_MESSAGE_TEMPLATES = [
    # TRANSLATORS: {primary} is the error of the main RAW decoder and {fallback}
    # the error of LibRaw, the backup decoder tried afterwards.
    N_("{primary} ; LibRaw fallback: {fallback}"),
    N_("cannot open RAW file: {detail}"),
    N_("RAW decoding failed: {detail}"),
    N_("decoding failed: {detail}"),
    N_("could not create the output file: {detail}"),
    N_("could not create the output folder: {detail}"),
    # TRANSLATORS: {format} is the target format name (JPEG, PNG, TIFF, BMP, WebP).
    N_("{format} encoding failed: {detail}"),
    N_("{name}: internal decoder error (corrupted file?)"),
    N_("skipped (the destination file already exists)"),
    N_("LibRaw: initialization failed"),
    N_("invalid path (null byte)"),
    N_("inconsistent {bits}-bit RAW buffer size"),
    N_("LibRaw: unexpected developed image (type {kind}, {colors} channels, {depth} bits)"),
    N_("LibRaw: inconsistent image size ({size} bytes, {expected} expected)"),
]


def _template_regex(template):
    parts = re.split(r"\{(\w+)\}", template)
    pattern = "".join(
        f"(?P<{part}>.*?)" if i % 2 else re.escape(part) for i, part in enumerate(parts)
    )
    return re.compile("^" + pattern + "$", re.DOTALL)


_ENGINE_PATTERNS = [(_template_regex(t), t) for t in ENGINE_MESSAGE_TEMPLATES]


def translate_engine_message(message):
    """Traduit un message d'erreur du moteur s'il correspond à un modèle
    connu (les parties variables, comme le détail d'une bibliothèque, sont
    conservées telles quelles) ; sinon le renvoie inchangé."""
    if not isinstance(message, str):
        return message
    for rx, template in _ENGINE_PATTERNS:
        m = rx.match(message)
        if m:
            fields = {k: translate_engine_message(v) for k, v in m.groupdict().items()}
            try:
                return _(template).format(**fields)
            except (KeyError, IndexError, ValueError):
                return message  # traduction mal formée : on garde l'anglais
    return message


def translate_format_label(label):
    msgid = FORMAT_LABELS.get(label)
    return _(msgid) if msgid else label


def read_path_list(list_file):
    paths = []
    with open(list_file, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line:
                paths.append(line)
    return paths


def common_parent_dir(paths):
    dirs = []
    for p in paths:
        dirs.append(p if os.path.isdir(p) else os.path.dirname(p))
    if not dirs:
        return os.path.expanduser("~")
    try:
        return os.path.commonpath(dirs)
    except ValueError:
        return os.path.dirname(dirs[0]) or os.path.expanduser("~")


class NewFolderDialog(Gtk.Window):
    """Petite fenêtre modale pour saisir le nom d'un nouveau dossier."""

    def __init__(self, parent, parent_dir, on_created):
        super().__init__(title=_("New folder"), transient_for=parent, modal=True)
        self.set_default_size(360, -1)
        self.parent_dir = parent_dir
        self.on_created = on_created

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_margin_top(16)
        box.set_margin_bottom(16)
        box.set_margin_start(16)
        box.set_margin_end(16)
        self.set_child(box)

        box.append(Gtk.Label(label=_("Create in: {folder}").format(folder=parent_dir), xalign=0))

        self.entry = Gtk.Entry()
        self.entry.set_placeholder_text(_("Folder name"))
        # TRANSLATORS: default name proposed for the new destination folder
        # (a single lowercase word, e.g. "converted").
        self.entry.set_text(_("converted"))
        box.append(self.entry)

        self.error_label = Gtk.Label(label="", xalign=0)
        self.error_label.add_css_class("error")
        box.append(self.error_label)

        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_box.set_halign(Gtk.Align.END)
        cancel_btn = Gtk.Button(label=_("Cancel"))
        cancel_btn.connect("clicked", lambda _b: self.close())
        create_btn = Gtk.Button(label=_("Create"))
        create_btn.add_css_class("suggested-action")
        create_btn.connect("clicked", self._on_create)
        btn_box.append(cancel_btn)
        btn_box.append(create_btn)
        box.append(btn_box)

        self.entry.connect("activate", self._on_create)

    def _on_create(self, _widget):
        name = self.entry.get_text().strip()
        if not name:
            self.error_label.set_text(_("The name cannot be empty."))
            return
        new_path = os.path.join(self.parent_dir, name)
        try:
            os.makedirs(new_path, exist_ok=True)
        except OSError as e:
            self.error_label.set_text(_("Could not create the folder: {error}").format(error=e))
            return
        self.on_created(new_path)
        self.close()


class ConvertImagesWindow(Gtk.ApplicationWindow):
    def __init__(self, app, input_paths):
        super().__init__(application=app, title=_("Convert images"))
        self.set_default_size(560, 640)
        self.input_paths = input_paths
        self.detected_files = []  # liste de (path, format_label, is_raw)
        self.output_dir = common_parent_dir(input_paths)
        self.convert_proc = None
        self.conversion_in_progress = False
        self.connect("close-request", self._on_close_request)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        root.set_margin_top(16)
        root.set_margin_bottom(16)
        root.set_margin_start(16)
        root.set_margin_end(16)
        self.set_child(root)

        self.status_label = Gtk.Label(label=_("Analyzing the selected files…"), xalign=0)
        self.status_label.set_wrap(True)
        root.append(self.status_label)

        self.detect_progress = Gtk.ProgressBar()
        self.detect_progress.set_show_text(False)
        root.append(self.detect_progress)

        # --- Options de conversion (masquées jusqu'à la fin de l'analyse) ---
        self.options_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.options_box.set_visible(False)
        root.append(self.options_box)

        grid = Gtk.Grid(row_spacing=8, column_spacing=12)
        self.options_box.append(grid)

        grid.attach(Gtk.Label(label=_("Destination format:"), xalign=0), 0, 0, 1, 1)
        self.format_dropdown = Gtk.DropDown.new_from_strings(
            [_(label) for _id, label in FORMAT_CHOICES]
        )
        self.format_dropdown.set_selected(0)  # JPEG par défaut
        self.format_dropdown.connect("notify::selected", self._on_format_changed)
        grid.attach(self.format_dropdown, 1, 0, 1, 1)

        self.quality_label = Gtk.Label(label=_("JPEG quality:"), xalign=0)
        grid.attach(self.quality_label, 0, 1, 1, 1)
        self.quality_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 100, 1)
        self.quality_scale.set_value(100)
        self.quality_scale.set_hexpand(True)
        self.quality_scale.set_digits(0)
        grid.attach(self.quality_scale, 1, 1, 1, 1)

        grid.attach(Gtk.Label(label=_("If the file already exists:"), xalign=0), 0, 2, 1, 1)
        self.collision_dropdown = Gtk.DropDown.new_from_strings(
            [_(label) for _id, label in COLLISION_CHOICES]
        )
        self.collision_dropdown.set_selected(0)
        grid.attach(self.collision_dropdown, 1, 2, 1, 1)

        grid.attach(Gtk.Label(label=_("Destination folder:"), xalign=0), 0, 3, 1, 1)
        dest_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.dest_label = Gtk.Label(label=self.output_dir, xalign=0)
        self.dest_label.set_ellipsize(3)  # PANGO_ELLIPSIZE_END
        self.dest_label.set_hexpand(True)
        dest_box.append(self.dest_label)
        browse_btn = Gtk.Button(label=_("Browse…"))
        browse_btn.connect("clicked", self._on_browse_clicked)
        dest_box.append(browse_btn)
        new_folder_btn = Gtk.Button(label=_("New folder…"))
        new_folder_btn.connect("clicked", self._on_new_folder_clicked)
        dest_box.append(new_folder_btn)
        grid.attach(dest_box, 1, 3, 1, 1)

        self._on_format_changed(self.format_dropdown, None)

        # --- Barre d'actions : Annuler/Convertir (masquée avec le reste des
        # options jusqu'à la fin de la détection) ---
        action_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        action_box.set_halign(Gtk.Align.END)
        self.cancel_btn = Gtk.Button(label=_("Cancel conversion"))
        self.cancel_btn.set_visible(False)
        self.cancel_btn.connect("clicked", self._on_cancel_clicked)
        action_box.append(self.cancel_btn)
        self.convert_btn = Gtk.Button(label=_("Convert"))
        self.convert_btn.add_css_class("suggested-action")
        self.convert_btn.connect("clicked", self._on_convert_clicked)
        action_box.append(self.convert_btn)
        self.options_box.append(action_box)

        self.convert_progress = Gtk.ProgressBar()
        self.convert_progress.set_visible(False)
        self.options_box.append(self.convert_progress)

        # --- Journal ---
        self.log_buffer = Gtk.TextBuffer()
        log_view = Gtk.TextView(buffer=self.log_buffer, editable=False, monospace=True)
        scroller = Gtk.ScrolledWindow()
        scroller.set_vexpand(True)
        scroller.set_child(log_view)
        scroller.set_visible(False)
        self.log_scroller = scroller
        root.append(scroller)

        self.open_dest_btn = Gtk.Button(label=_("Open the destination folder"))
        self.open_dest_btn.set_visible(False)
        self.open_dest_btn.connect("clicked", self._on_open_dest_clicked)
        root.append(self.open_dest_btn)

        # --- Quitter : toujours visible, même pendant la détection ---
        quit_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.quit_btn = Gtk.Button(label=_("Quit"))
        self.quit_btn.connect("clicked", self._on_quit_clicked)
        quit_bar.append(self.quit_btn)
        root.append(quit_bar)

        self._start_detection()

    # ---------------------------------------------------------------- detect

    def _start_detection(self):
        args = [ENGINE_BINARY, "detect", "--recursive"] + self.input_paths
        self._run_streaming(args, self._on_detect_line, self._on_detect_done)

    def _on_detect_line(self, event):
        kind = event.get("event")
        if kind == "file":
            self.detected_files.append(
                (event["path"], event["format"], event.get("is_raw", False))
            )
        elif kind == "summary":
            counts = event.get("counts", {})
            total = event.get("total", 0)
            if total == 0:
                self.status_label.set_text(
                    _("No recognized image file in the selection.")
                )
            else:
                details = ", ".join(
                    f"{n} {translate_format_label(fmt)}" for fmt, n in sorted(counts.items())
                )
                self.status_label.set_text(
                    ngettext(
                        "{n} file detected: {details}",
                        "{n} files detected: {details}",
                        total,
                    ).format(n=total, details=details)
                )

    def _on_detect_done(self, success, _returncode):
        self.detect_progress.set_visible(False)
        if not self.detected_files:
            self.convert_btn.set_sensitive(False)
        self.options_box.set_visible(True)

    # ------------------------------------------------------------- options

    def _on_format_changed(self, dropdown, _pspec):
        idx = dropdown.get_selected()
        fmt_id, _label = FORMAT_CHOICES[idx]
        is_jpeg = fmt_id == "jpeg"
        self.quality_label.set_visible(is_jpeg)
        self.quality_scale.set_visible(is_jpeg)

    def _on_browse_clicked(self, _btn):
        dialog = Gtk.FileDialog()
        dialog.set_title(_("Choose the destination folder"))
        initial = Gio.File.new_for_path(self.output_dir)
        dialog.set_initial_folder(initial)

        def on_response(dlg, result):
            try:
                folder = dlg.select_folder_finish(result)
            except GLib.Error:
                return
            if folder:
                self.output_dir = folder.get_path()
                self.dest_label.set_text(self.output_dir)

        dialog.select_folder(self, None, on_response)

    def _on_new_folder_clicked(self, _btn):
        def on_created(new_path):
            self.output_dir = new_path
            self.dest_label.set_text(self.output_dir)

        dlg = NewFolderDialog(self, self.output_dir, on_created)
        dlg.present()

    # ------------------------------------------------------------- convert

    def _on_convert_clicked(self, _btn):
        idx = self.format_dropdown.get_selected()
        fmt_id, _label = FORMAT_CHOICES[idx]
        collision_idx = self.collision_dropdown.get_selected()
        collision_id, _clabel = COLLISION_CHOICES[collision_idx]
        quality = int(self.quality_scale.get_value())

        os.makedirs(self.output_dir, exist_ok=True)

        args = [
            ENGINE_BINARY,
            "convert",
            "--recursive",
            "--output-dir",
            self.output_dir,
            "--format",
            fmt_id,
            "--quality",
            str(quality),
            "--on-collision",
            collision_id,
        ] + self.input_paths

        self.convert_btn.set_sensitive(False)
        self.cancel_btn.set_visible(True)
        self.convert_progress.set_visible(True)
        self.convert_progress.set_fraction(0.0)
        self.log_scroller.set_visible(True)
        self.log_buffer.set_text("")
        self.conversion_in_progress = True
        self._append_log(
            _("Converting to {format} → {folder}\n").format(
                format=fmt_id.upper(), folder=self.output_dir
            )
        )

        self._run_streaming(args, self._on_convert_line, self._on_convert_done)

    def _on_convert_line(self, event):
        kind = event.get("event")
        if kind == "start":
            self._convert_total = event.get("total", 0) or 1
        elif kind == "file_done":
            idx = event.get("index", 0)
            total = event.get("total", self._convert_total)
            self.convert_progress.set_fraction(min(1.0, idx / max(1, total)))
            if event.get("status") == "ok":
                self._append_log(
                    _("[OK] {input} → {output}\n").format(
                        input=event.get("input"), output=event.get("output")
                    )
                )
            else:
                self._append_log(
                    _("[ERROR] {input}: {message}\n").format(
                        input=event.get("input"),
                        message=translate_engine_message(event.get("message")),
                    )
                )
        elif kind == "summary":
            ok = event.get("ok", 0)
            errors = event.get("errors", 0)
            self._append_log(
                _("\nFinished — succeeded: {ok}, errors: {errors}.\n").format(ok=ok, errors=errors)
            )
            self.status_label.set_text(
                _("Conversion finished — succeeded: {ok}, errors: {errors}.").format(
                    ok=ok, errors=errors
                )
            )
        elif kind == "fatal_error":
            self._append_log(
                _("[FATAL ERROR] {message}\n").format(
                    message=translate_engine_message(event.get("message"))
                )
            )

    def _on_convert_done(self, success, _returncode):
        self.conversion_in_progress = False
        self.convert_btn.set_sensitive(True)
        self.cancel_btn.set_visible(False)
        self.open_dest_btn.set_visible(True)

    def _on_cancel_clicked(self, _btn):
        if self.convert_proc:
            self.convert_proc.force_exit()
        self._append_log(_("\nConversion cancelled by the user.\n"))

    def _on_open_dest_clicked(self, _btn):
        uri = GLib.filename_to_uri(self.output_dir, None)
        Gio.AppInfo.launch_default_for_uri(uri, None)

    # ---------------------------------------------------------------- quit

    def _on_quit_clicked(self, _btn):
        self._request_quit()

    def _on_close_request(self, _window):
        """Appelé quand l'utilisateur clique sur la croix de fermeture de
        la fenêtre. Retourne True pour bloquer la fermeture immédiate
        (le dialogue de confirmation décidera ensuite), False pour la
        laisser se faire normalement."""
        if self.conversion_in_progress:
            self._confirm_quit_dialog()
            return True
        return False

    def _request_quit(self):
        if self.conversion_in_progress:
            self._confirm_quit_dialog()
        else:
            self.get_application().quit()

    def _confirm_quit_dialog(self):
        dialog = Gtk.AlertDialog()
        dialog.set_message(_("Conversion in progress"))
        dialog.set_detail(
            _(
                "Quitting now will interrupt the conversion in progress. Files "
                "already converted stay on disk; the remaining ones will not be "
                "processed."
            )
        )
        dialog.set_buttons([_("Cancel"), _("Quit anyway")])
        dialog.set_cancel_button(0)
        dialog.set_default_button(0)

        def on_response(dlg, result):
            try:
                choice = dlg.choose_finish(result)
            except GLib.Error:
                return
            if choice == 1:
                if self.convert_proc:
                    self.convert_proc.force_exit()
                self.get_application().quit()

        dialog.choose(self, None, on_response)

    # ------------------------------------------------------------- helpers

    def _append_log(self, text):
        end = self.log_buffer.get_end_iter()
        self.log_buffer.insert(end, text)

    def _run_streaming(self, args, on_line, on_done):
        """Lance `args` en sous-processus et appelle `on_line(dict_json)`
        pour chaque ligne JSON reçue sur stdout, puis `on_done(success, code)`
        à la fin, sans jamais bloquer la boucle GTK."""
        try:
            proc = Gio.Subprocess.new(
                args, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE
            )
        except GLib.Error as e:
            self._append_log(_("[ERROR] could not start the engine: {error}\n").format(error=e))
            on_done(False, -1)
            return

        self.convert_proc = proc
        stdout = proc.get_stdout_pipe()
        stream = Gio.DataInputStream.new(stdout)

        def read_next():
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_read)

        def on_read(source, result):
            try:
                line, _len = source.read_line_finish_utf8(result)
            except GLib.Error:
                line = None
            if line is None:
                proc.wait_check_async(None, on_wait)
                return
            line = line.strip()
            if line:
                try:
                    event = json.loads(line)
                    on_line(event)
                except json.JSONDecodeError:
                    pass
            read_next()

        def on_wait(source, result):
            try:
                source.wait_check_finish(result)
                on_done(True, 0)
            except GLib.Error:
                on_done(False, source.get_exit_status())

        read_next()


class ConvertImagesApp(Gtk.Application):
    def __init__(self, input_paths):
        super().__init__(application_id="org.gillesmagneville.ConvertImages")
        self.input_paths = input_paths

    def do_activate(self):
        win = ConvertImagesWindow(self, self.input_paths)
        win.present()


def main():
    parser = argparse.ArgumentParser(description=_("nautilus-convert-images graphical interface"))
    parser.add_argument("--input-list", help=_("File containing one path per line"))
    parser.add_argument("paths", nargs="*", help=_("Files or folders to process"))
    args = parser.parse_args()

    input_paths = list(args.paths)
    if args.input_list:
        input_paths.extend(read_path_list(args.input_list))

    if not input_paths:
        print(_("No file or folder provided."), file=sys.stderr)
        sys.exit(1)

    app = ConvertImagesApp(input_paths)
    app.run([])


if __name__ == "__main__":
    main()
