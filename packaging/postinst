#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
#
# Post-install script (fpm --after-install), run as root.
set -e

# Restarts Nautilus if it is running, so that it reloads the list of Python
# extensions and picks up
# nautilus-convert-images immediately (otherwise, the menu entry
# only appears at the next login).
#
# The message shown follows the system language: English, French, Spanish
# or German, falling back to English. The language is chosen by the same
# rules as gettext (and therefore as the menu entry itself): take the
# first non-empty variable among LANGUAGE, LC_ALL, LC_MESSAGES and LANG; it
# may hold several languages separated by ":", the first available language
# wins; "C" and "POSIX" stop the search (English).
# This block is deliberately identical in raw-thumbs's postinst.
pick_language() {
    _lang=en
    _list=
    for _var in "${LANGUAGE:-}" "${LC_ALL:-}" "${LC_MESSAGES:-}" "${LANG:-}"; do
        if [ -n "$_var" ]; then
            _list=$_var
            break
        fi
    done
    _old_ifs=$IFS
    IFS=:
    set -f
    for _entry in $_list; do
        case $_entry in
            C | C.* | POSIX | POSIX.*) break ;;
            fr | fr_* | fr.* | fr@*) _lang=fr; break ;;
            es | es_* | es.* | es@*) _lang=es; break ;;
            de | de_* | de.* | de@*) _lang=de; break ;;
        esac
    done
    set +f
    IFS=$_old_ifs
    echo "$_lang"
}

if command -v nautilus >/dev/null 2>&1; then
    if pgrep -x nautilus >/dev/null 2>&1; then
        nautilus -q >/dev/null 2>&1 || true
        case "$(pick_language)" in
            fr) echo "nautilus-convert-images : Nautilus a été redémarré pour activer la nouvelle entrée de menu." ;;
            es) echo "nautilus-convert-images: Nautilus se ha reiniciado para activar la nueva entrada de menú." ;;
            de) echo "nautilus-convert-images: Nautilus wurde neu gestartet, um den neuen Menüeintrag zu aktivieren." ;;
            *)  echo "nautilus-convert-images: Nautilus was restarted to enable the new menu entry." ;;
        esac
    fi
fi

exit 0
